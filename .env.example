# Resend: https://resend.com → API Keys
RESEND_API_KEY=re_xxxxxxxx

# Empfänger der Kontaktformular-Nachrichten
CONTACT_TO_EMAIL=nika.chekurda@icloud.com

# WICHTIG (Resend ohne eigene Domain):
# Bis anicca.berlin bei Resend verifiziert ist, dürfen Test-Mails NUR an die
# E-Mail gehen, mit der du bei Resend registriert bist (z. B. deine Gmail).
# Sonst kommt Fehler 403 und keine Mail bei iCloud an.
# Lösung: https://resend.com/domains → anicca.berlin hinzufügen → DNS eintragen
# Danach Absender setzen:
# CONTACT_FROM_EMAIL=Anicca Pflege WG <kontakt@anicca.berlin>

# Absender (optional, Standard ohne Domain):
# CONTACT_FROM_EMAIL=Anicca Website <onboarding@resend.dev>
